        <article>
            <fieldset>
                <legend> Enter weight in kg </legend>

                <label for="weight"> Weight in kg: </label> </br>
                <input type = "number" id = "weight" required> <br>
                <button id="weight"> Convert </button> </br>

                <legend> Enter weight in lbs </legend>
